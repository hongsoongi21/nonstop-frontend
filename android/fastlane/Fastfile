default_platform(:android)

platform :android do
  desc "Build release APK"
  lane :build_release do
    Dir.chdir("..") do
      sh("flutter", "build", "apk", "--release")
    end
  end

  desc "Build release App Bundle"
  lane :build_bundle do
    Dir.chdir("..") do
      sh("flutter", "build", "appbundle", "--release")
    end
  end

  desc "Deploy to Firebase App Distribution"
  lane :firebase_internal do |options|
    build_number = options[:build_number] || "2"

    Dir.chdir("..") do
      sh("flutter", "build", "apk", "--release", "--build-number=#{build_number}")
    end

    firebase_app_distribution(
      app: "1:127473148279:android:2109fc50be2bbc3ec2c172",
      release_notes: options[:notes] || "Internal test build #{build_number}",
      apk_path: "../build/app/outputs/flutter-apk/app-release.apk",
    )
  end

  desc "Deploy to Play Store (Internal Testing)"
  lane :internal do |options|
    build_number = options[:build_number] || Time.now.strftime("%Y%m%d%H%M")

    Dir.chdir("..") do
      sh("flutter", "build", "appbundle", "--release", "--build-number=#{build_number}")
    end

    upload_to_play_store(
      track: "internal",
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Deploy to Play Store (Production) with metadata"
  lane :production do |options|
    build_number = options[:build_number] || Time.now.strftime("%Y%m%d%H%M")

    Dir.chdir("..") do
      sh("flutter", "build", "appbundle", "--release", "--build-number=#{build_number}")
    end

    upload_to_play_store(
      track: "production",
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      release_status: "draft",
    )
  end

  desc "Upload metadata only (no build)"
  lane :upload_metadata do
    upload_to_play_store(
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
    )
  end

  desc "Promote internal to production"
  lane :promote do |options|
    from = options[:from] || "internal"
    to = options[:to] || "production"

    upload_to_play_store(
      track: from,
      track_promote_to: to,
      skip_upload_changelogs: false,
    )
  end
end

default_platform(:ios)

# App Store Connect API Key 설정
ASC_API_KEY = app_store_connect_api_key(
  key_id: "9M5K2RF732",
  issuer_id: "5c73d830-bb60-4a1d-b94b-df36f51dd094",
  key_filepath: File.expand_path("keys/AuthKey_9M5K2RF732.p8", __dir__),
)

platform :ios do
  desc "Build release IPA"
  lane :build_release do |options|
    build_number = options[:build_number] || Time.now.strftime("%Y%m%d%H%M")

    Dir.chdir("../..") do
      sh("flutter", "build", "ipa", "--release",
         "--build-number=#{build_number}",
         "--export-options-plist=ios/ExportOptions-appstore.plist")
    end
  end

  desc "Deploy to Firebase App Distribution"
  lane :firebase_internal do |options|
    build_number = options[:build_number] || "2"

    Dir.chdir("../..") do
      sh("flutter", "build", "ipa", "--release",
         "--build-number=#{build_number}",
         "--export-options-plist=ios/ExportOptions-dev.plist")
    end

    project_root = File.expand_path("../..", __dir__)
    ipa = File.join(project_root, "build", "ios", "ipa", "nonstop.ipa")

    firebase_app_distribution(
      app: "1:127473148279:ios:1fe527d213701a6dc2c172",
      release_notes: options[:notes] || "Internal test build #{build_number}",
      ipa_path: ipa,
    )
  end

  desc "Deploy to TestFlight"
  lane :testflight do |options|
    build_number = options[:build_number] || Time.now.strftime("%Y%m%d%H%M")

    Dir.chdir("../..") do
      sh("flutter", "build", "ipa", "--release",
         "--build-number=#{build_number}",
         "--export-options-plist=ios/ExportOptions-appstore.plist")
    end

    project_root = File.expand_path("../..", __dir__)
    ipa = File.join(project_root, "build", "ios", "ipa", "nonstop.ipa")

    upload_to_testflight(
      api_key: ASC_API_KEY,
      ipa: ipa,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
    )
  end

  desc "Upload already-built IPA to App Store (binary only, no metadata)"
  lane :production_upload do
    project_root = File.expand_path("../..", __dir__)
    ipa = File.join(project_root, "build", "ios", "ipa", "nonstop.ipa")

    upload_to_app_store(
      api_key: ASC_API_KEY,
      ipa: ipa,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      ignore_language_directory_validation: true,
      force: true,
    )
  end

  desc "Deploy to App Store (Production) with metadata"
  lane :production do |options|
    build_number = options[:build_number] || Time.now.strftime("%Y%m%d%H%M")

    Dir.chdir("../..") do
      sh("flutter", "build", "ipa", "--release",
         "--build-number=#{build_number}",
         "--export-options-plist=ios/ExportOptions-appstore.plist")
    end

    project_root = File.expand_path("../..", __dir__)
    ipa = File.join(project_root, "build", "ios", "ipa", "nonstop.ipa")

    upload_to_app_store(
      api_key: ASC_API_KEY,
      ipa: ipa,
      skip_metadata: false,
      skip_screenshots: false,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false,
    )
  end

  desc "Upload metadata only (no build)"
  lane :upload_metadata do
    deliver(
      api_key: ASC_API_KEY,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      force: true,
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false,
    )
  end

  desc "Download current metadata from App Store"
  lane :download_metadata do
    deliver(
      api_key: ASC_API_KEY,
      app_identifier: "uz.merge4.nonstop",
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: true,
      force: true,
      run_precheck_before_submit: false,
    )
  end
end

# Matchfile for iOS code signing
# https://docs.fastlane.tools/actions/match/

git_url(ENV["MATCH_GIT_URL"])
storage_mode("git")

type("appstore") # Default type, can be: appstore, adhoc, development, enterprise

app_identifier([ENV["APP_IDENTIFIER"] || "com.example.nonstop"])
username(ENV["APPLE_ID"])

# For CI/CD environments
readonly(is_ci)

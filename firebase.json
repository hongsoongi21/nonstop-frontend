{
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "nonstop-c2aa4",
          "appId": "1:127473148279:android:2109fc50be2bbc3ec2c172",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "nonstop-c2aa4",
          "configurations": {
            "android": "1:127473148279:android:2109fc50be2bbc3ec2c172",
            "ios": "1:127473148279:ios:1fe527d213701a6dc2c172"
          }
        }
      },
      "ios": {
        "default": {
          "projectId": "nonstop-c2aa4",
          "appId": "1:127473148279:ios:1fe527d213701a6dc2c172",
          "uploadDebugSymbols": true,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      }
    }
  }
}

{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter: Run (Development)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define=ENVIRONMENT=development",
        "--dart-define=API_BASE_URL=http://10.0.2.2:28080",
        "--dart-define=WS_BASE_URL=ws://10.0.2.2:28080/ws"
      ]
    },
    {
      "name": "Flutter: Run on Android Emulator",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "emulator-5554",
      "args": [
        "--dart-define=ENVIRONMENT=development",
        "--dart-define=API_BASE_URL=http://10.0.2.2:28080",
        "--dart-define=WS_BASE_URL=ws://10.0.2.2:28080/ws"
      ]
    },
    {
      "name": "Flutter: Run on Chrome",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome"
    },
    {
      "name": "Flutter: Debug (Profile Mode)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "profile"
    },
    {
      "name": "Flutter: Debug (Release Mode)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "release"
    },
    {
      "name": "Flutter: Attach to Running App",
      "request": "attach",
      "type": "dart"
    }
  ]
}
